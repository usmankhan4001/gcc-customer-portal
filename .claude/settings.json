{
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run typecheck)",
      "Bash(npm test:*)",
      "Bash(npm run build)",
      "Bash(npm run test:routes)",
      "Bash(npm run db:generate)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Bash(npm run db:migrate:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
