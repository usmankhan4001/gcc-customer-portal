# ============================================================================
# GCCStartup — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/gccstartup?sslmode=require

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Stripe secret key for server-side API calls
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe webhook signing secret for verifying incoming webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Cloudflare R2 (Object Storage) ─────────────────────────────────────────
# R2 account ID from the Cloudflare dashboard
R2_ACCOUNT_ID=xxx
# R2 API token access key ID
R2_ACCESS_KEY_ID=xxx
# R2 API token secret access key
R2_SECRET_ACCESS_KEY=xxx
# R2 bucket name for document storage
R2_BUCKET_NAME=gccstartup-vault

# ─── WhatsApp Cloud API ──────────────────────────────────────────────────────
# Meta Business Suite access token for WhatsApp messaging
WHATSAPP_ACCESS_TOKEN=xxx
# WhatsApp Business phone number ID (15-digit number)
WHATSAPP_PHONE_NUMBER_ID=xxx

# ─── Resend (Email) ─────────────────────────────────────────────────────────
# Resend API key for transactional email delivery
RESEND_API_KEY=re_xxx

# ─── Auth ────────────────────────────────────────────────────────────────────
# JWT signing secret — MUST be changed in production
JWT_SECRET=gccstartup-dev-secret-change-in-production

# ─── App ─────────────────────────────────────────────────────────────────────
# Public-facing app URL (used for links in emails/notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3005
